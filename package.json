{
  "name": "verify-fix",
  "version": "0.1.4",
  "private": false,
  "description": "Pre-merge verification CLI: AI-free oracle engine for agent-proposed monitoring-check repairs.",
  "type": "module",
  "license": "MIT",
  "author": "Aminah",
  "homepage": "https://github.com/GreyyDaze/verify-fix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreyyDaze/verify-fix.git"
  },
  "bugs": {
    "url": "https://github.com/GreyyDaze/verify-fix/issues"
  },
  "keywords": [
    "checkly",
    "playwright",
    "monitoring",
    "synthetic-monitoring",
    "verification",
    "agent",
    "ai",
    "ci",
    "gate",
    "oracle",
    "mutation-testing"
  ],
  "bin": {
    "verify-fix": "bin/verify-fix"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/ci-gate.sh",
    "action.yml",
    "README.md",
    "LICENSE",
    "src/execution/sandbox/check-api.ts",
    "src/evidence/assertion/id.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "node --no-warnings --test \"test/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "node src/cli.ts",
    "test:checkly": "node --no-warnings scripts/checkly-acceptance.ts",
    "test:checkly-acceptance": "node --no-warnings scripts/checkly-acceptance.ts",
    "test:checkly:verify": "node --no-warnings scripts/checkly-verify-acceptance.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "typescript": "^5.7.0"
  }
}
