# Blank examples only. Copy to .env.local for local runs. Never commit real values.
# API_TOKEN is required only when exercising the authenticated Phase 6 route.

# Shared session store. Without these the app keeps sessions in memory,
# which is fine on one laptop but NOT on Vercel (each serverless instance
# would have its own memory and the incident would be invisible).
# Vercel's "Upstash for Redis" marketplace integration injects KV_REST_API_*;
# a manually created Upstash database gives you UPSTASH_REDIS_REST_*.
# Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# How long the booking page "loads availability" before the Book buttons
# appear. This is the width of the race window between two overlapping
# monitoring runs. Default 1500 ms.
SLOT_LOAD_DELAY_MS=1500

# Authenticated API route and ApiCheck setup script.
API_TOKEN=
ENVIRONMENT_URL=http://localhost:3000

# Check runtime values used by local verification or the Phase 5 CI gate.
# GitHub/Checkly hold real values. These names are examples only.
TEST_USER=demo
# TEST_USER_US_EAST_1=
# TEST_USER_EU_WEST_1=
# CHECKLY_SECRET_VERCEL_AUTOMATION_BYPASS_SECRET=
