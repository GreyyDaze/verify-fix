# Copy to .env for LOCAL / ad-hoc runs only. Never commit .env.
#
# Where the check points. Leave empty to target production (see playwright.config.ts).
# For a Vercel preview:  ENVIRONMENT_URL=https://slots-booking-git-<branch>-<team>.vercel.app
ENVIRONMENT_URL=

# The account the check logs in with. In Checkly this is a check-level
# environment variable (see checkly.config.ts). Only names live in git.
TEST_USER=demo

# Checkly credentials for `npx checkly test` / `npx checkly deploy`.
# Get them from https://app.checklyhq.com/settings/user/api-keys
# and https://app.checklyhq.com/settings/account/general
CHECKLY_API_KEY=
CHECKLY_ACCOUNT_ID=
